# Configuracoes de Performance

## Simplicacao

# 0.01: Muito simplificado — para mapas de todo o Brasil ou mundo, onde só quer um contorno “grosso” (e olhe lá!).
# 0.001: Já simplifica bem, mas ainda mantém o formato das cidades — geralmente é o valor "seguro" para aplicações web, dashboards, etc.
# 0.0005: Muito detalhado, mas ainda reduz um pouco os vértices; fica ótimo para zoom intermediário.
# 0.0001: Quase não simplifica; só remove micro-serrilhados ou ruídos de digitização.

GEOMETRY_TOLERANCE=0.001
GEOMETRY_DECIMALS=6


## Workers e Threads
GUNICORN_WORKERS=4
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
# ---- Opcionais (versão 1.2.0) ----
# Claims exigidos no JWT. Os clientes (dashboard e Terra-AI) já enviam estes valores.
# JWT_AUDIENCE=terra-geodata-mini-server
# JWT_ISSUERS=dashboard_fundiario_ceara,terra_ai
# Chave do pseudônimo de proprietário (id_proprietario). Vazia: derivada do JWT_SECRET.
# PSEUDONIMIZACAO_SECRET=
# Origens CORS permitidas, separadas por vírgula. A API é consumida só por servidores.
# ALLOWED_ORIGINS=*
# Segundos de cache das listas de regiões e municípios.
# CACHE_LISTAS_SEGUNDOS=600
# Tabela com o registro das cargas (endpoint /versao_dados).
# TABLE_CARGAS=carga_dados
# Carga dos CSVs a cada inicialização do container (true/false).
# IMPORTAR_DADOS_NA_INICIALIZACAO=true
