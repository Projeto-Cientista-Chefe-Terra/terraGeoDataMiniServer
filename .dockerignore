# Segredos e ambientes locais
.env
# Os CSVs têm dados pessoais (nomes de proprietários) e não podem entrar na imagem publicada.
# O rm -rf do entrypoint só apaga a pasta no container; nas camadas da imagem ela continuaria.
# Para uma carga, monte a pasta em /tgdmserver/datasets e use IMPORTAR_DADOS_NA_INICIALIZACAO=true.
datasets/
*.env
.venv/
.git/

# Caches e saídas locais
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
logs/
*.log
$HOME/
data/

# Não fazem parte do servidor em execução
.vscode/
para_apagar/
tests/
doc/
scripts/
*.in
test-geoapi.py
testes_api.sh
conta-json.py
all_json_to_csv.py
colunas_dos_datasets.txt
otimizacoes.md
gen_cert.sh
